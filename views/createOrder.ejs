<!doctype html><html lang="vi"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Create New Order</title><link rel="stylesheet" href="/style.css"></head><body><main class="panel small"><h1>Create New Order</h1><% if(error){ %><p class="error"><%= error %></p><% } %><form action="/orders" method="post"><label>Customer Name<input name="customerName" required></label><label>Product Name<select name="productId" required><option value="">Select product</option><% products.forEach(p=>{ %><option value="<%=p._id%>"><%=p.productName%> - <%=p.unitPrice.toLocaleString('vi-VN')%> VND</option><% }) %></select></label><label>Quantity<input type="number" min="1" step="1" name="quantity" required></label><label>Order Date<input type="date" name="orderDate" required></label><button>Place Order</button><a class="btn gold block" href="/orders">Go Back</a></form></main></body></html>