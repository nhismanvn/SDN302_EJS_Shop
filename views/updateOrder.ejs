<!doctype html><html lang="vi"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Update Order</title><link rel="stylesheet" href="/style.css"></head><body><main class="panel small"><h1>Update Order</h1><% if(error){ %><p class="error"><%= error %></p><% } %><form action="/orders/<%=order._id%>/update" method="post"><label>Customer Name<input name="customerName" value="<%=order.customerName%>" required></label><label>Product Name<select name="productId" required><% products.forEach(p=>{ %><option value="<%=p._id%>" <%=p.productName===order.productName?'selected':''%>><%=p.productName%></option><% }) %></select></label><label>Quantity<input type="number" min="1" step="1" name="quantity" value="<%=order.quantity%>" required></label><label>Order Date<input type="date" name="orderDate" value="<%=new Date(order.orderDate).toISOString().slice(0,10)%>" required></label><button>Update Order</button><a class="btn gold block" href="/orders">Go Back</a></form></main></body></html>