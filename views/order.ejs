<!doctype html><html lang="vi"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Product Orders</title><link rel="stylesheet" href="/style.css"></head><body><main class="panel"><div class="top"><span>Logged in: <%= user.email %> (<%= user.role %>)</span><form action="/logout" method="post"><button class="light">Logout</button></form></div><h1>Product Orders</h1><div class="overflow"><table><thead><tr><th>Customer Name</th><th>Product Name</th><th>Quantity</th><th>Order Date</th><th>Total Price</th><th>Actions</th></tr></thead><tbody><% orders.forEach(o=>{ %><tr><td><%= o.customerName %></td><td><%= o.productName %></td><td><%= o.quantity %></td><td><%= new Date(o.orderDate).toLocaleDateString('en-US') %></td><td><%= o.totalPrice.toLocaleString('vi-VN') %> VND</td><td><% if(user.role==='admin'){ %><a class="btn" href="/orders/<%= o._id %>/edit">Update</a><form class="inline" action="/orders/<%= o._id %>/delete" method="post" onsubmit="return confirm('Delete this order?')"><button class="gold">Delete</button></form><% } %></td></tr><% }) %></tbody></table></div><% if(user.role==='admin'){ %><p class="center"><a class="btn" href="/orders/new">Create New Order</a></p><% } %></main></body></html>